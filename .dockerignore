# Исключаем локальную папку с библиотеками (чтобы не было конфликтов систем)
node_modules/
npm-debug.log*

# Исключаем локальную базу данных салона и её временные файлы отката
*.sqlite
*.sqlite-journal

# Исключаем файлы Git (Докеру они не нужны для работы)
.git/
.gitignore

# Исключаем документацию проекта и тяжелые скриншоты для README
README.md
images/

# Исключаем конфигурационные файлы самого Докера из контекста сборки
Dockerfile
docker-compose.yml
